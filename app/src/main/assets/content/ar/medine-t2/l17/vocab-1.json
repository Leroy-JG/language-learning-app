            ["lui", "{ar|يُمْكِنُهُ}", "il peut"],
            ["elle", "{ar|يُمْكِنُهَا}", "elle peut"],
            ["nous", "{ar|يُمْكِنُنَا}", "nous pouvons"],
            ["vous (des hommes)", "{ar|يُمْكِنُكُمْ}", "vous pouvez"],
            ["eux", "{ar|يُمْكِنُهُمْ}", "ils peuvent"]
          ]
        },
        {
          "type": "note",
          "tone": "info",
          "text": "Littéralement, {ar|يُمْكِنُنِي أَنْ أَذْهَبَ} veut dire « il m'est possible de partir ». Dans {ar|يُمْكِنُنِي}, il y a un {ar|ن} de protection ({ar|نُونُ الْوِقَايَةِ}) entre le verbe et le pronom {ar|◌ِي}."
        }

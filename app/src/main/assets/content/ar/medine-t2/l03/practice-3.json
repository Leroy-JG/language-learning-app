      "title": "L'exercice 4 du livre",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Le professeur donne trois mots (le sujet, un adjectif, le second terme) et demande de former une phrase avec le comparatif. Modèle : {ar|هَاشِمٌ} / {ar|طَوِيلٌ} / {ar|عُثْمَانُ} donne {ar|هَاشِمٌ أَطْوَلُ مِنْ عُثْمَانَ}."
        }
      ]
    },
    {
      "id": "medine-t2.l03.practice-3#2",
      "type": "order",
      "fr": "Hāshim est plus grand (de taille) que ʿUthmān.",
      "answers": [["هَاشِمٌ", "أَطْوَلُ", "مِنْ", "عُثْمَانَ"]],
      "punctuation": "."
    },
    {
      "id": "medine-t2.l03.practice-3#3",
      "type": "order",
      "fr": "Le Caire est plus grand que Riyad.",
      "answers": [["الْقَاهِرَةُ", "أَكْبَرُ", "مِنَ", "الرِّيَاضِ"]],
      "punctuation": "."
    },
    {
      "id": "medine-t2.l03.practice-3#4",
      "type": "order",
      "fr": "Cet hôtel est plus propre que celui-là.",
      "answers": [["هٰذَا", "الْفُنْدُقُ", "أَنْظَفُ", "مِنْ", "ذَاكَ"]],
      "punctuation": "."
    },
    {
      "id": "medine-t2.l03.practice-3#5",
      "type": "typing",
      "ask": "fr",
      "fr": "Je suis plus grand que lui.",
      "answers": ["أَنَا أَكْبَرُ مِنْهُ.", "أَنَا أَطْوَلُ مِنْهُ."]
    },
    {
      "id": "medine-t2.l03.practice-3#6",
      "type": "typing",
      "ask": "fr",
      "fr": "Il est plus petit que toi.",
      "answers": ["هُوَ أَصْغَرُ مِنْكَ."]
    },
    {
      "id": "medine-t2.l03.practice-3#7",
      "type": "typing",
      "ask": "fr",
      "fr": "Tu es meilleur que moi.",
      "answers": ["أَنْتَ أَحْسَنُ مِنِّي."]
    },
    {
      "id": "medine-t2.l03.practice-3#8",
      "type": "typing",
      "ask": "fr",
      "fr": "Le soleil est plus loin que la lune.",
      "answers": ["الشَّمْسُ أَبْعَدُ مِنَ الْقَمَرِ."]

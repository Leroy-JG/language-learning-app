            ["{ar|الْمَحَطَّةُ} (féminin)", "{ar|الْقَادِمَةُ}", "la prochaine station"]
          ]
        },
        {
          "type": "example",
          "ar": "سَأَنْزِلُ فِي الْمَحَطَّةِ الْقَادِمَةِ.",
          "fr": "Je descendrai à la prochaine station."
        },
        {
          "type": "note",
          "tone": "info",
          "text": "Tu as aussi rencontré {ar|أَمَانٌ} dans la formule d'adieu {ar|فِي أَمَانِ اللَّهِ} (« Qu'Allah te garde »)."
        },
        {
          "type": "note",
          "tone": "warning",
          "text": "Ne confonds pas {ar|قَادِمٌ} (« prochain ») avec {ar|قَدِيمٌ} (« ancien ») : ils partagent les lettres {ar|ق}, {ar|د}, {ar|م}, mais {ar|قَادِمٌ} a un alif après le {ar|ق}, et {ar|قَدِيمٌ} un {ar|ي} après le {ar|د}."
        }
      ]

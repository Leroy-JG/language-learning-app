      "type": "dialogue",
      "title": "Dans le bus : faire connaissance",
      "intro": "Dans un bus, deux jeunes hommes se saluent. Fayṣal interroge ʿAbd Allāh : son nom, ses études, ses professeurs.",
      "speakers": { "F": { "name": "Fayṣal", "voice": "m1" }, "A": { "name": "ʿAbd Allāh", "voice": "m2" } },
      "lines": [
        { "speaker": "F", "ar": "السَّلَامُ عَلَيْكُمْ.", "fr": "Que la paix soit sur vous." },
        {
          "speaker": "A",
          "ar": "وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.",
          "fr": "Et sur vous la paix, ainsi que la miséricorde d'Allah et ses bénédictions."
        },
        { "speaker": "F", "ar": "مَا اسْمُكَ يَا أَخِي؟", "fr": "Quel est ton nom, mon frère ?" },
        {
          "speaker": "A",
          "ar": "اِسْمِي عَبْدُ اللَّهِ، وَمَا اسْمُكَ؟",
          "fr": "Mon nom est ʿAbd Allāh, et toi, quel est ton nom ?"
        },
        {
          "speaker": "F",
          "ar": "اِسْمِي فَيْصَلٌ. أَطَالِبٌ أَنْتَ يَا عَبْدَ اللَّهِ؟",
          "fr": "Mon nom est Fayṣal. Es-tu étudiant, ʿAbd Allāh ?"
        },
        { "speaker": "A", "ar": "نَعَمْ.", "fr": "Oui." },
        { "speaker": "F", "ar": "أَيْنَ تَدْرُسُ يَا أَخِي؟", "fr": "Où étudies-tu, mon frère ?" },
        { "speaker": "A", "ar": "أَدْرُسُ بِجَامِعَةِ الرِّيَاضِ.", "fr": "J'étudie à l'université de Riyad." },
        { "speaker": "F", "ar": "فِي أَيِّ كُلِّيَّةٍ تَدْرُسُ؟", "fr": "Dans quelle faculté étudies-tu ?" },
        {
          "speaker": "A",
          "ar": "أَدْرُسُ فِي كُلِّيَّةِ الْهَنْدَسَةِ.",
          "fr": "J'étudie à la faculté d'ingénierie."
        },
        { "speaker": "F", "ar": "فِي أَيِّ سَنَةٍ تَدْرُسُ؟", "fr": "En quelle année étudies-tu ?" },
        { "speaker": "A", "ar": "أَدْرُسُ فِي السَّنَةِ الثَّانِيَةِ.", "fr": "J'étudie en deuxième année." },
        { "speaker": "F", "ar": "أَتَعْرِفُ الْمُهَنْدِسَ سَلْمَانَ؟", "fr": "Connais-tu l'ingénieur Salmān ?" },
        {
          "speaker": "A",
          "ar": "طَبْعًا. هُوَ أُسْتَاذِي. هُوَ أَحْسَنُ مُدَرِّسٍ فِي الْكُلِّيَّةِ.",
          "fr": "Bien sûr. C'est mon professeur. C'est le meilleur enseignant de la faculté."
        }
      ]
    },
    {

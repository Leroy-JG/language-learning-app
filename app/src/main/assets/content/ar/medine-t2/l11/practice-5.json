            }
          ]
        },
        {
          "type": "note",
          "tone": "info",
          "text": "Le nom change aussi : {ar|طَالِبٌ} → {ar|طُلَّابٌ} ; {ar|أُخْتٌ} → {ar|أَخَوَاتٌ}. Dans les deux cas, le mot change au pluriel (tome 1)."
        }
      ]

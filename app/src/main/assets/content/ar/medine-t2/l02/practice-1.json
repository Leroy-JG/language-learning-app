            ["{ar|نَحْنُ}", "{ar|أَكَلْنَا}", "nous avons mangé"],
            ["{ar|أَنْتَ}", "{ar|أَكَلْتَ}", "tu as mangé (à un homme)"],
            ["{ar|أَنْتِ}", "{ar|أَكَلْتِ}", "tu as mangé (à une femme)"],
            ["{ar|أَنْتُمَا}", "{ar|أَكَلْتُمَا}", "vous avez mangé (à deux personnes)"],
            ["{ar|أَنْتُمْ}", "{ar|أَكَلْتُمْ}", "vous avez mangé (à plusieurs hommes)"],
            ["{ar|أَنْتُنَّ}", "{ar|أَكَلْتُنَّ}", "vous avez mangé (à plusieurs femmes)"],
            ["{ar|هُوَ}", "{ar|أَكَلَ}", "il a mangé"],
            ["{ar|هِيَ}", "{ar|أَكَلَتْ}", "elle a mangé"],
            ["{ar|هُمَا}", "{ar|أَكَلَا}", "eux deux ont mangé"],
            ["{ar|هُمْ}", "{ar|أَكَلُوا}", "ils ont mangé"],
            ["{ar|هُنَّ}", "{ar|أَكَلْنَ}", "elles ont mangé"]
          ]
        },

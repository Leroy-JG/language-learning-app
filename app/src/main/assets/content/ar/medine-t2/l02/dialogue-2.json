    {
      "id": "medine-t2.l02.dialogue-2#1",
      "type": "dialogue",
      "title": "Hishām et Bilāl : les enfants et la famille",
      "intro": "Suite du texte du livre : Bilāl interroge Hishām sur ses fils, ses filles, ses frères et ses sœurs.",
      "speakers": { "B": { "name": "Bilāl", "voice": "m1" }, "H": { "name": "Hishām", "voice": "m2" } },
      "lines": [
        { "speaker": "B", "ar": "أَلَكَ أَبْنَاءٌ يَا هِشَامُ؟", "fr": "As-tu des fils, Hishām ?" },
        { "speaker": "H", "ar": "نَعَمْ، لِي سِتَّةُ أَبْنَاءٍ.", "fr": "Oui, j'ai six fils." },
        { "speaker": "B", "ar": "أَطُلَّابٌ هُمْ؟", "fr": "Sont-ils étudiants ?" },
        {
          "speaker": "H",
          "ar": "لَا، هُمْ لَيْسُوا بِطُلَّابٍ. إِنَّ بَعْضَهُمْ تُجَّارٌ وَبَعْضُهُمْ مُهَنْدِسُونَ.",
          "fr": "Non, ils ne sont pas étudiants. Certains sont commerçants et d'autres ingénieurs."
        },
        { "speaker": "B", "ar": "أَلَكَ بَنَاتٌ؟", "fr": "As-tu des filles ?" },
        { "speaker": "H", "ar": "نَعَمْ، لِي خَمْسُ بَنَاتٍ.", "fr": "Oui, j'ai cinq filles." },
        { "speaker": "B", "ar": "أَمُتَزَوِّجَاتٌ هُنَّ؟", "fr": "Sont-elles mariées ?" },
        {
          "speaker": "H",
          "ar": "لَا، هُنَّ لَسْنَ بِمُتَزَوِّجَاتٍ. إِنَّهُنَّ صِغَارٌ. بَعْضُهُنَّ فِي الْمَدْرَسَةِ الِابْتِدَائِيَّةِ وَبَعْضُهُنَّ فِي الْمَدْرَسَةِ الْمُتَوَسِّطَةِ.",
          "fr": "Non, elles ne sont pas mariées. Elles sont petites. Certaines sont à l'école primaire et d'autres au collège."
        },
        { "speaker": "B", "ar": "أَلَكَ إِخْوَةٌ؟", "fr": "As-tu des frères ?" },
        {
          "speaker": "H",
          "ar": "لَا، لَيْسَ لِي إِخْوَةٌ. إِنَّ لِي ثَلَاثَ أَخَوَاتٍ.",
          "fr": "Non, je n'ai pas de frères. J'ai trois sœurs."
        },
        { "speaker": "B", "ar": "أَمُسْلِمَاتٌ هُنَّ؟", "fr": "Sont-elles musulmanes ?" },
        {
          "speaker": "H",
          "ar": "نَعَمْ، هُنَّ مُسْلِمَاتٌ، وَالْحَمْدُ لِلَّهِ.",
          "fr": "Oui, elles sont musulmanes, louange à Allah."
        }
      ]
    },
    {

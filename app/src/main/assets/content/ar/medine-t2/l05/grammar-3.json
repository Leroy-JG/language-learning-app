        { "ar": "ضَرَبَكَ زَيْدٌ.", "category": 1 },
        { "ar": "ضَرَبَ زَيْدٌ يَاسِرًا.", "category": 0 },
        { "ar": "قَرَأْتُ الْكِتَابَ.", "category": 0 },
        { "ar": "قَرَأْتُهُ.", "category": 1 }
      ],

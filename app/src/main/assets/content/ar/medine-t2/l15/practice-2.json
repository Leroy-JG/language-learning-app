      "prompt": { "fr": "Que veut dire {ar|اِفْتَحِ النَّافِذَةَ وَلَا تَفْتَحِ الْبَابَ} ?" },
      "choices": [
        { "fr": "Ouvre la fenêtre et n'ouvre pas la porte" },

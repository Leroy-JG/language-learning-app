            {
              "from": { "ar": "زَيْدٌ مُجْتَهِدٌ", "fr": "Zayd est studieux." },
              "to": { "ar": "زَيْدٌ غَيْرُ مُجْتَهِدٍ", "fr": "Zayd n'est pas studieux." },
              "label": "{ar|غَيْرُ} nie ; le mot qui suit est au génitif"
            }
          ]
        }
      ]
    },

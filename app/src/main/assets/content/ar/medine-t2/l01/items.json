[
  {
    "id": "w:nasikh",
    "kind": "word",
    "ar": "النَّاسِخُ",
    "fr": "l'abrogeant (outil qui change la phrase nominale)",
    "translit": "an-nāsikhu",
    "plural": "النَّوَاسِخُ",
    "gender": "m",
    "note": "Au sens propre, {ar|نَاسِخٌ} est « celui qui abroge, qui annule ». Ici, c'est un mot qui, placé devant une phrase nominale, en change le sens et le cas de ses deux éléments."
  },
  {
    "id": "w:inna",
    "kind": "word",
    "ar": "إِنَّ",
    "fr": "certes, en vérité (elle confirme la phrase)",
    "translit": "inna",
    "note": "Elle se place au début de la phrase. Le sujet qui la suit passe à l'accusatif ; le prédicat reste au nominatif.",
    "example": { "ar": "إِنَّ زَيْدًا طَالِبٌ.", "fr": "Certes, Zayd est étudiant." }
  },
  {
    "id": "w:anna",
    "kind": "word",
    "ar": "أَنَّ",
    "fr": "que (elle confirme la phrase, au milieu d'une phrase)",
    "translit": "anna",
    "note": "Même sens et même effet sur la phrase que {ar|إِنَّ}, mais elle ne commence pas la phrase : elle vient après un autre mot (« je sais que… »)."
  },
  {
    "id": "w:laalla",
    "kind": "word",
    "ar": "لَعَلَّ",
    "fr": "peut-être, j'espère que",
    "translit": "laʿalla",
    "note": "Elle exprime l'espoir ou la probabilité que la chose se réalise. Le sujet qui la suit passe à l'accusatif.",
    "example": { "ar": "لَعَلَّ زَيْدًا نَاجِحٌ.", "fr": "Espérons que Zayd réussisse." }
  },
  {
    "id": "w:najih",
    "kind": "word",
    "ar": "نَاجِحٌ",
    "fr": "qui réussit",
    "translit": "nājiḥun",
    "note": "Participe actif du verbe {ar|نَجَحَ} (« réussir »), employé comme adjectif.",
    "example": { "ar": "زَيْدٌ نَاجِحٌ.", "fr": "Zayd réussit." }
  },
  {
    "id": "w:ism-inna",
    "kind": "word",
    "ar": "اِسْمُ إِنَّ",
    "fr": "le nom de {ar|إِنَّ} (le sujet après {ar|إِنَّ}, à l'accusatif)",
    "translit": "ismu inna",
    "gender": "m"
  },
  {

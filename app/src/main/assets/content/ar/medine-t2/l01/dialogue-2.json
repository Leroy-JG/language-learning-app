      "type": "dialogue",
      "title": "Hāshim et son professeur : la famille",
      "intro": "Suite du texte du livre : le professeur interroge Hāshim sur le prix de la montre, puis sur ses frères et ses sœurs.",
      "speakers": { "T": { "name": "Le professeur", "voice": "m1" }, "H": { "name": "Hāshim", "voice": "m2" } },
      "lines": [
        { "speaker": "T", "ar": "أَغَالِيَةٌ هِيَ أَمْ رَخِيصَةٌ؟", "fr": "Est-elle chère ou bon marché ?" },
        {
          "speaker": "H",
          "ar": "إِنَّهَا رَخِيصَةٌ جِدًّا. إِنَّهَا بِمِائَةِ رُوبِيَّةٍ فَقَطْ.",
          "fr": "Elle est très bon marché. Elle coûte cent roupies seulement."
        },
        { "speaker": "T", "ar": "كَمْ أَخًا لَكَ يَا هَاشِمُ؟", "fr": "Combien de frères as-tu, Hāshim ?" },
        { "speaker": "H", "ar": "لِي ثَلَاثَةُ إِخْوَةٍ.", "fr": "J'ai trois frères." },
        { "speaker": "T", "ar": "أَطُلَّابٌ هُمْ؟", "fr": "Sont-ils étudiants ?" },
        { "speaker": "H", "ar": "لَا، إِنَّهُمْ تُجَّارٌ.", "fr": "Non, ce sont des commerçants." },
        { "speaker": "T", "ar": "وَكَمْ أُخْتًا لَكَ؟", "fr": "Et combien de sœurs as-tu ?" },
        { "speaker": "H", "ar": "لِي أَرْبَعُ أَخَوَاتٍ.", "fr": "J'ai quatre sœurs." },
        { "speaker": "T", "ar": "أَفِي الْهِنْدِ هُنَّ الْآنَ؟", "fr": "Sont-elles en Inde maintenant ?" },
        {
          "speaker": "H",
          "ar": "لَا، إِنَّهُنَّ هُنَا بِالْمَدِينَةِ الْمُنَوَّرَةِ مَعَ أَبِي وَأُمِّي.",
          "fr": "Non, elles sont ici, à Médine, avec mon père et ma mère."
        },
        { "speaker": "T", "ar": "أَطَالِبَاتٌ هُنَّ؟", "fr": "Sont-elles étudiantes ?" }
      ]
    },

      "fr": "Muḥammad est sorti de l'école.",
      "gaps": [{ "answers": ["مِنَ"] }],
      "options": ["مِنَ", "فِي", "عَلَى"]
    },
    {
      "id": "medine-t1.l04.vocab-5#9",
      "type": "fill_gap",
      "sentence": "ذَهَبَ الْوَلَدُ {0} الْمَسْجِدِ.",
      "fr": "Le garçon est allé à la mosquée.",
      "gaps": [{ "answers": ["إِلَى"] }],
      "options": ["إِلَى", "مِنَ", "عَلَى"]
    },
    {
      "id": "medine-t1.l04.vocab-5#9b",
      "type": "tip",
      "title": "Poser une question sur le verbe",
      "blocks": [
        { "type": "example", "ar": "أَيْنَ ذَهَبَ؟", "fr": "Où est-il allé ?" },
        { "type": "example", "ar": "مَنْ خَرَجَ مِنَ الْفَصْلِ؟", "fr": "Qui est sorti de la salle de classe ?" },
        { "type": "note", "text": "Le mot interrogatif ouvre la phrase : il n'est précédé que d'une préposition ou de {ar|وَ} ({ar|مِنْ أَيْنَ}, {ar|وَأَيْنَ}). Avec {ar|مَنْ}, c'est celui qui fait l'action." }
      ]
    },
    {
      "id": "medine-t1.l04.vocab-5#10",
      "type": "question",
      "prompt": { "fr": "Que veut dire {ar|ذَهَبَ} ?" },
      "choices": [ { "fr": "il est allé" }, { "fr": "il est sorti" }, { "fr": "il a écrit" } ],

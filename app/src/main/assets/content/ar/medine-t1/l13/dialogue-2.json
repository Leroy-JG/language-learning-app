        { "speaker": "B", "ar": "نَعَمْ. هُنَّ أَخَوَاتٌ.", "fr": "Oui. Elles sont sœurs." },
        { "speaker": "A", "ar": "مَنْ أَبُوهُنَّ؟", "fr": "Qui est leur père ?" },
        {
          "speaker": "B",
          "ar": "أَبُوهُنَّ الشَّيْخُ بِلَالٌ. أُمُّهُنَّ أُسْتَاذَتِي.",
          "fr": "Leur père est le cheikh Bilāl. Leur mère est ma professeure."
        },
        { "speaker": "A", "ar": "أَيْنَ بَيْتُهُنَّ؟", "fr": "Où est leur maison ?" },

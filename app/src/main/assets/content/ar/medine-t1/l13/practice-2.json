    {
      "id": "medine-t1.l13.practice-2#1",
      "type": "tip",
      "title": "Les phrases du livre",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Le livre te demande de mettre le sujet au pluriel et de changer ce qu'il faut : le démonstratif, le nom, l'adjectif et le mot qui dit ce qu'ils sont. Regarde :"
        },
        {
          "type": "compare",
          "rows": [
            {
              "from": { "ar": "مِنْ أَيْنَ ذٰلِكَ الْمُدَرِّسُ؟", "fr": "D'où vient cet enseignant-là ?" },
              "to": { "ar": "مِنْ أَيْنَ أُولَئِكَ الْمُدَرِّسُونَ؟", "fr": "D'où viennent ces enseignants-là ?" }
            },
            {
              "from": { "ar": "مَنْ هٰذَا الْوَلَدُ الطَّوِيلُ؟", "fr": "Qui est ce grand garçon-ci ?" },
              "to": { "ar": "مَنْ هَؤُلَاءِ الْأَوْلَادُ الطِّوَالُ؟", "fr": "Qui sont ces grands garçons-ci ?" }
            },
            {
              "from": { "ar": "هٰذِهِ الْمَرْأَةُ مُمَرِّضَةٌ", "fr": "Cette femme-ci est infirmière." },
              "to": { "ar": "هَؤُلَاءِ النِّسَاءُ مُمَرِّضَاتٌ", "fr": "Ces femmes-ci sont infirmières." }
            },
            {
              "from": { "ar": "تِلْكَ الْفَتَاةُ بِنْتُ الطَّبِيبِ", "fr": "Cette jeune fille-là est la fille du médecin." },
              "to": {
                "ar": "أُولَئِكَ الْفَتَيَاتُ بَنَاتُ الطَّبِيبِ",
                "fr": "Ces jeunes filles-là sont les filles du médecin."
              }
            },
            {
              "from": { "ar": "ذٰلِكَ الرَّجُلُ عَالِمٌ كَبِيرٌ", "fr": "Cet homme-là est un grand savant." },
              "to": { "ar": "أُولَئِكَ الرِّجَالُ عُلَمَاءُ كِبَارٌ", "fr": "Ces hommes-là sont de grands savants." }
            },
            {
              "from": { "ar": "أَذٰلِكَ الْمُهَنْدِسُ مُسْلِمٌ؟", "fr": "Cet ingénieur-là est-il musulman ?" },
              "to": { "ar": "أَأُولَئِكَ الْمُهَنْدِسُونَ مُسْلِمُونَ؟", "fr": "Ces ingénieurs-là sont-ils musulmans ?" }
            }
          ]
        }
      ]
    },

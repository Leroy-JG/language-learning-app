            { "ar": "زَيْدُ", "fr": "le nom interpellé" }
          ]
        },
        { "type": "paragraph", "text": "Le nom de la personne appelée s'appelle {ar|الْمُنَادَى} (« celui qu'on appelle »)." }
      ]
    },
    { "id": "medine-t1.l05.grammar-5#2", "type": "present", "item": "w:ya" },

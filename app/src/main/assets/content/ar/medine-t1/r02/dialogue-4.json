            [
              "{ar|كَتَبَ تَمَارِينَهُ}",
              "il a écrit ses exercices",
              "{ar|تَمَارِينُ} est à l'accusatif : c'est ce qu'on écrit ; {ar|هُ} veut dire « ses »"
            ],
            [
              "{ar|كَتَبْتَ}, {ar|كَتَبْتُ}",
              "tu as écrit, j'ai écrit",
              "le {ar|تَ} final veut dire « tu » ; le {ar|تُ} final veut dire « je »"
            ],
            [
              "{ar|كُلَّهَا}, {ar|مِنْهَا}",
              "tous, d'entre eux",
              "{ar|هَا} reprend {ar|تَمَارِينُ} : plusieurs choses sont reprises par {ar|هَا}"
            ],
            ["{ar|هَاتِ}", "donne !", "chapitre 23"],
            [
              "{ar|عَشَرَةُ أَسْئِلَةٍ}",
              "dix questions",
              "{ar|سُؤَالٌ} est masculin : le nombre garde le {ar|ة} (chapitre 19)"
            ],
            ["{ar|اِفْتَحُوا}", "ouvrez", "l'impératif pluriel du verbe {ar|فَتَحَ}"]
          ]
        },
        { "type": "note", "text": "Tu n'as pas à les apprendre maintenant : tu les étudieras plus tard." }
      ]
    },

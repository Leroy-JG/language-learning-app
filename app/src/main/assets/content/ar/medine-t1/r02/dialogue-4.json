  "title": "Zayd à l'école (2)",
  "icon": "teacher",
  "screens": [
    {
      "id": "medine-t1.r02.dialogue-4#1",
      "type": "dialogue",
      "title": "En classe avec le professeur",
      "intro": "Le professeur parle avec Zayd et Muḥammad, puis ils parlent de l'examen de demain.",
      "speakers": {
        "T": { "name": "Le professeur", "voice": "m1" },
        "Z": { "name": "Zayd", "voice": "m2" },
        "M": { "name": "Muḥammad", "voice": "m2" }
      },
      "lines": [
        {
          "speaker": "T",
          "ar": "كَيْفَ أَنْتَ يَا زَيْدُ؟ اِجْلِسْ مَعَ الطُّلَّابِ.",
          "fr": "Comment vas-tu, Zayd ? Assieds-toi avec les étudiants."
        },
        { "speaker": "Z", "ar": "أَيْنَ يَاسِرٌ يَا أُسْتَاذُ؟", "fr": "Où est Yāsir, professeur ?" },
        {
          "speaker": "T",
          "ar": "هُوَ مَرِيضٌ الْيَوْمَ. مَنْ كَتَبَ تَمَارِينَهُ؟",
          "fr": "Il est malade aujourd'hui. Qui a écrit ses exercices ?"
        },
        { "speaker": "M", "ar": "أَنَا يَا أُسْتَاذُ.", "fr": "Moi, professeur." },
        { "speaker": "T", "ar": "وَمَا كَتَبْتَ مِنْهَا؟", "fr": "Et qu'en as-tu écrit ?" },
        { "speaker": "M", "ar": "كَتَبْتُ كُلَّهَا.", "fr": "Je les ai tous écrits." },
        { "speaker": "T", "ar": "حَسَنًا، هَاتِ دَفْتَرَكَ.", "fr": "D'accord, donne ton cahier." },
        { "speaker": "Z", "ar": "مَتَى الِاخْتِبَارُ يَا أُسْتَاذُ؟", "fr": "Quand est l'examen, professeur ?" },
        { "speaker": "T", "ar": "غَدًا إِنْ شَاءَ اللَّهُ.", "fr": "Demain, si Allah le veut." },
        {
          "speaker": "Z",
          "ar": "أَيُّ دَرْسٍ مَوْضُوعُ الِاخْتِبَارِ؟ وَكَمْ سُؤَالًا فِيهِ؟",
          "fr": "Quelle leçon est le sujet de l'examen ? Et combien de questions y a-t-il dedans ?"
        },
        {
          "speaker": "T",
          "ar": "فِيهِ عَشَرَةُ أَسْئِلَةٍ وَمَوْضُوعُهُ النَّحْوُ.",
          "fr": "Il y a dix questions et son sujet est la grammaire."
        },
        {
          "speaker": "Z",
          "ar": "مَا رَأْيُكُمْ فِي مُرَاجَعَةٍ الْيَوْمَ يَا أُسْتَاذُ؟",
          "fr": "Que pensez-vous d'une révision aujourd'hui, professeur ?"
        },
        { "speaker": "T", "ar": "حَسَنًا، اِفْتَحُوا دَفَاتِرَكُمْ.", "fr": "D'accord, ouvrez vos cahiers." }
      ]
    },
    {
      "id": "medine-t1.r02.dialogue-4#2",
      "type": "tip",
      "title": "Des petites formes à repérer",
      "blocks": [
        {
          "type": "table",
          "header": ["Dans le dialogue", "Sens", "Explication"],
          "rows": [

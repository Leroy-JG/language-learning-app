        {
          "speaker": "A",
          "ar": "السَّلَامُ عَلَيْكِ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.",
          "fr": "Que la paix soit sur toi, ainsi que la miséricorde d'Allah et ses bénédictions."
        },
        {
          "speaker": "B",
          "ar": "وَعَلَيْكِ السَّلَامُ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.",
          "fr": "Et sur toi la paix, ainsi que la miséricorde d'Allah et ses bénédictions."
        },
        { "speaker": "A", "ar": "كَيْفَ حَالُكِ يَا بِنْتُ؟", "fr": "Comment vas-tu, jeune fille ?" },
        { "speaker": "B", "ar": "أَنَا بِخَيْرٍ وَالْحَمْدُ لِلَّهِ.", "fr": "Je vais bien, louange à Allah." },
        { "speaker": "A", "ar": "مِنْ أَيْنَ أَنْتِ؟", "fr": "D'où viens-tu ?" },
        { "speaker": "B", "ar": "أَنَا مِنَ الرِّيَاضِ.", "fr": "Je viens de Riyad." },
        { "speaker": "A", "ar": "مَا اسْمُكِ؟", "fr": "Quel est ton nom ?" },
        { "speaker": "B", "ar": "اِسْمِي آمِنَةُ.", "fr": "Mon nom est Āmina." },
        { "speaker": "A", "ar": "أَيْنَ أَبُوكِ؟", "fr": "Où est ton père ?" },
        {
          "speaker": "B",
          "ar": "أَبِي هُنَا فِي الْمَدِينَةِ الْمُنَوَّرَةِ. هُوَ مُوَجِّهٌ فِي الْمَدْرَسَةِ الثَّانَوِيَّةِ.",
          "fr": "Mon père est ici, à Médine. Il est conseiller au lycée."
        },

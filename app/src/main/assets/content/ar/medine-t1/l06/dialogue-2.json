      "lines": [
        { "speaker": "A", "ar": "لِمَنْ هٰذِهِ الْقِدْرُ؟", "fr": "À qui est cette marmite ?" },
        { "speaker": "B", "ar": "هٰذِهِ لِخَالِدٍ.", "fr": "Elle est à Khālid." },
        { "speaker": "A", "ar": "وَلِمَنْ هٰذِهِ الْبَقَرَةُ؟", "fr": "Et à qui est cette vache ?" },
        { "speaker": "B", "ar": "هٰذِهِ بَقَرَةُ الْفَلَّاحِ.", "fr": "C'est la vache du paysan." },
        { "speaker": "A", "ar": "وَهٰذِهِ الدَّجَاجَةُ؟", "fr": "Et cette poule ?" },
        { "speaker": "B", "ar": "هِيَ لِلْفَلَّاحِ أَيْضًا.", "fr": "Elle est aussi au paysan." }

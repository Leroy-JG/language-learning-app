      "lines": [
        { "speaker": "A", "ar": "مَنْ هٰذَا؟", "fr": "Qui est-ce ?" },
        { "speaker": "B", "ar": "هٰذَا اِبْنُ حَامِدٍ.", "fr": "C'est le fils de Ḥāmid." },

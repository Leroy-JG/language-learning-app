        { "speaker": "B", "ar": "هٰذِهِ بِنْتُ يَاسِرٍ.", "fr": "C'est la fille de Yāsir." },
        { "speaker": "A", "ar": "أَهِيَ جَالِسَةٌ؟", "fr": "Est-elle assise ?" },
        {
          "speaker": "B",
          "ar": "لَا، هِيَ وَاقِفَةٌ. وَابْنُ حَامِدٍ جَالِسٌ.",
          "fr": "Non, elle est debout. Et le fils de Ḥāmid est assis."
        }
      ]
    },
    {

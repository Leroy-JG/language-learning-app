  "screens": [
    {
      "id": "medine-t1.l09.dialogue-1#1",
      "type": "dialogue",
      "title": "Où est l'enseignant ?",
      "intro": "Yāsir cherche les enseignants et un nouvel étudiant.",
      "speakers": { "A": { "name": "Yāsir", "voice": "m2" }, "B": { "name": "Ḥāmid", "voice": "m1" } },
      "lines": [
        { "speaker": "A", "ar": "أَيْنَ الْمُدَرِّسُ؟", "fr": "Où est l'enseignant ?" },
        { "speaker": "B", "ar": "هُوَ فِي الْفَصْلِ.", "fr": "Il est dans la salle de classe." },
        { "speaker": "A", "ar": "وَأَيْنَ الْمُدَرِّسُ الْجَدِيدُ؟", "fr": "Et où est le nouvel enseignant ?" },
        { "speaker": "B", "ar": "هُوَ عِنْدَ الْمُدِيرِ.", "fr": "Il est chez le directeur." },
        { "speaker": "A", "ar": "وَأَيْنَ الطَّالِبُ الْجَدِيدُ؟", "fr": "Et où est le nouvel étudiant ?" },
        { "speaker": "B", "ar": "ذَهَبَ إِلَى الْبَيْتِ.", "fr": "Il est allé à la maison." }
      ]
    },
    {
      "id": "medine-t1.l09.dialogue-1#2",
      "type": "dialogue",
      "title": "Le grand homme",
      "intro": "Saʿīd et ʿAlī regardent des gens passer.",
      "speakers": { "A": { "name": "Saʿīd", "voice": "m1" }, "B": { "name": "ʿAlī", "voice": "m2" } },
      "lines": [
        { "speaker": "A", "ar": "مَنْ ذٰلِكَ الرَّجُلُ الطَّوِيلُ؟", "fr": "Qui est ce grand homme, là-bas ?" },
        { "speaker": "B", "ar": "هُوَ الْمُدِيرُ الْجَدِيدُ.", "fr": "C'est le nouveau directeur." },
        { "speaker": "A", "ar": "وَمَنِ الْوَلَدُ الصَّغِيرُ؟", "fr": "Et qui est le petit garçon ?" },
        { "speaker": "B", "ar": "هُوَ اِبْنُ الْمُدِيرِ الْجَدِيدِ.", "fr": "C'est le fils du nouveau directeur." }
      ]
    },

[
  {
    "id": "w:muthanna",
    "kind": "word",
    "ar": "الْمُثَنَّى",
    "fr": "le duel",
    "translit": "al-muthannā",
    "gender": "m",
    "note": "Le duel désigne **exactement deux** êtres ou deux choses. Tu en connais déjà des pronoms : {ar|هُمَا} et {ar|أَنْتُمَا} (chapitre 10)."

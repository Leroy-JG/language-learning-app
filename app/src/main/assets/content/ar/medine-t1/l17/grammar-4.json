          "type": "table",
          "header": ["Pour…", "Exemples"],
          "rows": [
            ["des prénoms féminins", "{ar|الزَّيْنَبَاتُ} (les Zaynab), {ar|الْفَاطِمَاتُ} (les Fāṭima)"],
            [
              "des noms ou des adjectifs de femmes",
              "{ar|الطَّالِبَاتُ مُجْتَهِدَاتٌ} (les étudiantes sont studieuses), {ar|الْمُسْلِمَاتُ عَفِيفَاتٌ} (les musulmanes sont vertueuses)"
            ],
            [
              "beaucoup de noms en {ar|ة}, y compris de choses",

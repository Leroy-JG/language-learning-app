[
  {
    "id": "w:ayy",
    "kind": "word",
    "ar": "أَيُّ",
    "fr": "quel… ? (quelle… ?)",
    "translit": "ayyu",
    "note": "Nom interrogatif de sens très général : il ne dit pas lui-même s'il interroge sur un lieu, un moment, une personne ou une chose ; c'est le nom qui le suit qui le dit. Il se place presque toujours devant un nom.",
    "example": { "ar": "أَيُّ يَوْمٍ هٰذَا؟", "fr": "Quel jour est-ce ?" }
  },
  {
    "id": "w:kulliyya",
    "kind": "word",
    "ar": "كُلِّيَّةٌ",
    "fr": "une faculté",
    "translit": "kulliyyatun",
    "plural": "كُلِّيَّاتٌ",
    "gender": "f",
    "note": "C'est une partie d'une université ({ar|جَامِعَةٌ}, chapitre 4).",
    "example": { "ar": "هٰذِهِ كُلِّيَّةٌ كَبِيرَةٌ.", "fr": "Ceci est une grande faculté." }
  },
  {
    "id": "w:handasa",
    "kind": "word",
    "ar": "هَنْدَسَةٌ",
    "fr": "de l'ingénierie",
    "translit": "handasatun",
    "gender": "f",
    "note": "De la même famille que {ar|مُهَنْدِسٌ} (un ingénieur, chapitre 5). Le mot veut aussi dire « géométrie ».",
    "example": {
      "ar": "أَخِي طَالِبٌ فِي كُلِّيَّةِ الْهَنْدَسَةِ.",
      "fr": "Mon frère est étudiant à la faculté d'ingénierie."
    }
  },
  {
    "id": "w:tijara",
    "kind": "word",
    "ar": "تِجَارَةٌ",
    "fr": "du commerce",
    "translit": "tijāratun",
    "plural": "تِجَارَاتٌ",
    "gender": "f",
    "note": "De la même famille que {ar|تَاجِرٌ} (un commerçant, chapitre 1).",
    "example": {
      "ar": "أَخُوكَ طَالِبٌ فِي كُلِّيَّةِ التِّجَارَةِ.",
      "fr": "Ton frère est étudiant à la faculté de commerce."
    }
  },
  {
    "id": "w:tibb",
    "kind": "word",
    "ar": "طِبٌّ",
    "fr": "de la médecine",
    "translit": "ṭibbun",
    "gender": "m",
    "note": "De la même famille que {ar|طَبِيبٌ} (un médecin, chapitre 1).",
    "example": { "ar": "أُخْتِي طَالِبَةٌ فِي كُلِّيَّةِ الطِّبِّ.", "fr": "Ma sœur est étudiante à la faculté de médecine." }
  },
  {
    "id": "w:balad",
    "kind": "word",
    "ar": "بَلَدٌ",
    "fr": "un pays",
    "translit": "baladun",
    "plural": "بِلَادٌ",
    "gender": "m",
    "note": "On trouve aussi le pluriel {ar|بُلْدَانٌ}.",
    "example": { "ar": "هٰذَا بَلَدٌ كَبِيرٌ.", "fr": "C'est un grand pays." }
  },
  {

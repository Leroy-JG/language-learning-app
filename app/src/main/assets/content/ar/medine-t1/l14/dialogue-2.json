    {
      "id": "medine-t1.l14.dialogue-2#1",
      "type": "dialogue",
      "title": "Le camarade venu d'Angleterre",
      "intro": "Ḥāmid remarque un jeune homme dans la voiture des frères et interroge Maḥmūd.",
      "speakers": {
        "A": { "name": "Ḥāmid", "voice": "m1" },
        "B": { "name": "Maḥmūd", "voice": "m2" },
        "C": { "name": "Yūsuf", "voice": "m2" }
      },
      "lines": [
        {
          "speaker": "A",
          "ar": "مَنْ ذٰلِكَ الْفَتَى الَّذِي فِي سَيَّارَتِكُمْ؟",
          "fr": "Qui est ce jeune homme qui est dans votre voiture ?"
        },
        { "speaker": "B", "ar": "هُوَ زَمِيلِي.", "fr": "C'est mon camarade." },
        { "speaker": "A", "ar": "مِنْ أَيْنَ هُوَ؟", "fr": "D'où vient-il ?" },
        { "speaker": "B", "ar": "هُوَ مِنْ إِنْكِلْتِرَا.", "fr": "Il vient d'Angleterre." },
        { "speaker": "A", "ar": "مَا اسْمُهُ؟", "fr": "Quel est son nom ?" },
        { "speaker": "B", "ar": "اِسْمُهُ وِلْيَمُ.", "fr": "Son nom est William." },
        { "speaker": "A", "ar": "أَمُسْلِمٌ هُوَ؟", "fr": "Est-il musulman ?" },
        {
          "speaker": "B",
          "ar": "لَا. هُوَ نَصْرَانِيٌّ. أَبُوهُ أُسْتَاذِي. اِسْمُهُ الدُّكْتُورُ إِدْوَرْدُ.",
          "fr": "Non. Il est chrétien. Son père est mon professeur. Son nom est le docteur Edward."
        },
        {
          "speaker": "B",
          "ar": "يَهْدِيهِمَا اللَّهُ إِلَى الْإِسْلَامِ.",
          "fr": "Qu'Allah les guide tous les deux vers l'islam."
        },
        {
          "speaker": "A",
          "ar": "أَذَهَبْتُمْ إِلَى الْمُسْتَشْفَى لِزِيَارَةِ عَمِّكُمُ الْيَوْمَ؟",
          "fr": "Êtes-vous allés à l'hôpital rendre visite à votre oncle aujourd'hui ?"
        },
        { "speaker": "C", "ar": "نَعَمْ. ذَهَبْنَا.", "fr": "Oui. Nous y sommes allés." }
      ]
    },
    {
      "id": "medine-t1.l14.dialogue-2#2",

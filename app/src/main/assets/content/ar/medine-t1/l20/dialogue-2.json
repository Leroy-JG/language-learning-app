      "type": "dialogue",
      "title": "Combien de frères et de sœurs ?",
      "intro": "Salmā demande à Laylā combien de sœurs et de frères elle a. Puis Laylā parle d'une camarade, Khadīja.",
      "speakers": { "A": { "name": "Laylā", "voice": "f1" }, "B": { "name": "Salmā", "voice": "f1" } },
      "lines": [
        { "speaker": "B", "ar": "كَمْ أُخْتًا لَكِ يَا لَيْلَى؟", "fr": "Combien de sœurs as-tu, Laylā ?" },
        { "speaker": "A", "ar": "لِي ثَلَاثُ أَخَوَاتٍ.", "fr": "J'ai trois sœurs." },
        { "speaker": "B", "ar": "وَكَمْ أَخًا لَكِ؟", "fr": "Et combien de frères as-tu ?" },
        { "speaker": "A", "ar": "لِي خَمْسَةُ إِخْوَةٍ.", "fr": "J'ai cinq frères." },
        {
          "speaker": "B",
          "ar": "لَكِ ثَلَاثُ أَخَوَاتٍ وَخَمْسَةُ إِخْوَةٍ.",
          "fr": "Tu as trois sœurs et cinq frères."
        },
        {
          "speaker": "A",
          "ar": "نَعَمْ، وَكَمْ أَخًا وَأُخْتًا لَكِ؟",
          "fr": "Oui. Et toi, combien de frères et de sœurs as-tu ?"
        },
        {
          "speaker": "B",
          "ar": "لِي أَرْبَعَةُ إِخْوَةٍ وَأَرْبَعُ أَخَوَاتٍ.",
          "fr": "J'ai quatre frères et quatre sœurs."
        },
        {
          "speaker": "A",
          "ar": "لِي زَمِيلَةٌ اِسْمُهَا خَدِيجَةُ. لَهَا ثَمَانِيَةُ إِخْوَةٍ وَثَمَانِي أَخَوَاتٍ.",
          "fr": "J'ai une camarade qui s'appelle Khadīja. Elle a huit frères et huit sœurs."
        }
      ]
    },

            ["{ar|٣}", "{ar|ثَلَاثَةٌ}", "{ar|ثَلَاثٌ}"],
            ["{ar|٤}", "{ar|أَرْبَعَةٌ}", "{ar|أَرْبَعٌ}"],
            ["{ar|٥}", "{ar|خَمْسَةٌ}", "{ar|خَمْسٌ}"]
          ]
        },
        { "type": "note", "text": "Tu connais déjà {ar|وَاحِدٌ} (chapitre 10)." },
        {

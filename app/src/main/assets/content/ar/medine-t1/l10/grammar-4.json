        {
          "type": "paragraph",
          "text": "Le pronom affixe se colle aussi à une préposition ({ar|حَرْفُ جَرٍّ}) : {ar|فِي} + {ar|هُ} donne {ar|فِيهِ} (en lui, dedans). Comme le nom qui suit une préposition, le pronom est alors au génitif ({ar|الْجَرُّ})."
        },
        {
          "type": "breakdown",
          "ar": "لَهُ",
          "fr": "à lui",
          "parts": [ { "ar": "لَ", "fr": "à" }, { "ar": "هُ", "fr": "lui" } ]

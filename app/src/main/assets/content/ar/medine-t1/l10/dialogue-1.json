{
  "id": "medine-t1.l10.dialogue-1",
  "type": "dialogue",
  "title": "Qui es-tu ? Qui est-ce ?",
  "icon": "speech",
  "screens": [
    {
      "id": "medine-t1.l10.dialogue-1#1",
      "type": "dialogue",
      "title": "Qui es-tu ?",
      "intro": "Ḥāmid rencontre Muḥammad, un nouvel étudiant.",
      "speakers": { "A": { "name": "Ḥāmid", "voice": "m1" }, "B": { "name": "Muḥammad", "voice": "m2" } },
      "lines": [
        { "speaker": "A", "ar": "مَنْ أَنْتَ؟", "fr": "Qui es-tu ?" },
        { "speaker": "B", "ar": "أَنَا طَالِبٌ بِالْجَامِعَةِ.", "fr": "Je suis étudiant à l'université." },
        { "speaker": "A", "ar": "أَأَنْتَ طَالِبٌ جَدِيدٌ؟", "fr": "Es-tu un nouvel étudiant ?" },
        { "speaker": "B", "ar": "نَعَمْ. أَنَا طَالِبٌ جَدِيدٌ.", "fr": "Oui. Je suis un nouvel étudiant." },
        { "speaker": "A", "ar": "مِنْ أَيْنَ أَنْتَ؟", "fr": "D'où viens-tu ?" },
        { "speaker": "B", "ar": "أَنَا مِنَ الْهِنْدِ.", "fr": "Je viens d'Inde." },
        { "speaker": "A", "ar": "مَا اسْمُكَ؟", "fr": "Quel est ton nom ?" },
        { "speaker": "B", "ar": "اِسْمِي مُحَمَّدٌ.", "fr": "Mon nom est Muḥammad." }
      ]
    },
    {
      "id": "medine-t1.l10.dialogue-1#2",
      "type": "dialogue",
      "title": "Ton camarade",
      "intro": "Ḥāmid remarque le jeune homme qui est avec Muḥammad.",
      "speakers": { "A": { "name": "Ḥāmid", "voice": "m1" }, "B": { "name": "Muḥammad", "voice": "m2" } },
      "lines": [
        {
          "speaker": "A",
          "ar": "وَمَنْ هٰذَا الْفَتَى الَّذِي مَعَكَ؟",
          "fr": "Et qui est ce jeune homme qui est avec toi ?"
        },
        { "speaker": "B", "ar": "هُوَ زَمِيلِي.", "fr": "C'est mon camarade." },
        { "speaker": "A", "ar": "أَهُوَ أَيْضًا مِنَ الْهِنْدِ؟", "fr": "Est-il aussi d'Inde ?" },
        { "speaker": "B", "ar": "لَا. هُوَ مِنَ الْيَابَانِ.", "fr": "Non. Il est du Japon." },
        { "speaker": "A", "ar": "مَا اسْمُهُ؟", "fr": "Quel est son nom ?" },
        { "speaker": "B", "ar": "اِسْمُهُ حَمْزَةُ.", "fr": "Son nom est Ḥamza." }
      ]
    },
    {
      "id": "medine-t1.l10.dialogue-1#3",
      "type": "tip",
      "title": "Des petites formes à repérer",
      "blocks": [
        {
          "type": "paragraph",
          "text": "Dans ces dialogues, quelques formes n'ont pas encore été étudiées. Tu peux déjà les comprendre :"
        },
        {
          "type": "table",
          "header": ["Dans le dialogue", "Sens"],
          "rows": [
            [
              "{ar|بِالْجَامِعَةِ}",
              "à l'université : la particule {ar|بِ} (ici « à, dans ») se colle au mot qui suit"
            ],
            ["{ar|الَّذِي}", "qui, que : ce mot relie « ce jeune homme » à « qui est avec toi »"]
          ]
        },
        { "type": "note", "text": "Tu n'as pas à les apprendre maintenant : tu les étudieras plus tard." }
      ]
    },

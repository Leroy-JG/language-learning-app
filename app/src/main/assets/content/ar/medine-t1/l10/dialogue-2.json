      "type": "dialogue",
      "title": "Quelle est ta langue ?",
      "intro": "Ḥāmid demande à Muḥammad quelle langue il parle.",
      "speakers": { "A": { "name": "Ḥāmid", "voice": "m1" }, "B": { "name": "Muḥammad", "voice": "m2" } },
      "lines": [
        { "speaker": "A", "ar": "مَا لُغَتُكَ يَا مُحَمَّدُ؟", "fr": "Quelle est ta langue, Muḥammad ?" },
        { "speaker": "B", "ar": "لُغَتِي الْأُرْدِيَّةُ.", "fr": "Ma langue est l'ourdou." },
        { "speaker": "A", "ar": "أَهِيَ لُغَةٌ سَهْلَةٌ؟", "fr": "Est-ce une langue facile ?" },
        { "speaker": "B", "ar": "نَعَمْ. هِيَ لُغَةٌ سَهْلَةٌ.", "fr": "Oui. C'est une langue facile." },
        { "speaker": "A", "ar": "وَحَمْزَةُ، مَا لُغَتُهُ؟", "fr": "Et Ḥamza, quelle est sa langue ?" },
        {
          "speaker": "B",
          "ar": "لُغَتُهُ الْيَابَانِيَّةُ، وَهِيَ لُغَةٌ صَعْبَةٌ.",
          "fr": "Sa langue est le japonais, et c'est une langue difficile."
        }
      ]
    },

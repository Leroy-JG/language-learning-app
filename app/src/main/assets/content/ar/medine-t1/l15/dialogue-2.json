  "title": "Quand ? Dans quelle école ?",
  "icon": "girl",
  "screens": [
    {
      "id": "medine-t1.l15.dialogue-2#1",
      "type": "dialogue",
      "title": "La suite de la conversation",
      "intro": "Zaynab veut savoir quand la mère des jeunes filles est partie, et comment elles vont.",
      "speakers": { "A": { "name": "Zaynab", "voice": "f1" }, "B": { "name": "Les jeunes filles", "voice": "f1" } },
      "lines": [
        { "speaker": "A", "ar": "مَتَى ذَهَبَتْ؟", "fr": "Quand est-elle partie ?" },
        { "speaker": "B", "ar": "ذَهَبَتْ قَبْلَ أُسْبُوعٍ.", "fr": "Elle est partie il y a une semaine." },
        { "speaker": "A", "ar": "مَنْ ذَهَبَ مَعَهَا؟", "fr": "Qui est parti avec elle ?" },
        {
          "speaker": "B",
          "ar": "ذَهَبَ مَعَهَا أَخُونَا إِبْرَاهِيمُ.",
          "fr": "Notre frère Ibrāhīm est parti avec elle."
        },
        { "speaker": "A", "ar": "كَيْفَ حَالُكُنَّ؟", "fr": "Comment allez-vous ?" },
        { "speaker": "B", "ar": "نَحْنُ بِخَيْرٍ وَالْحَمْدُ لِلَّهِ.", "fr": "Nous allons bien, louange à Allah." },
        { "speaker": "A", "ar": "فِي أَيِّ مَدْرَسَةٍ أَنْتُنَّ؟", "fr": "Dans quelle école êtes-vous ?" },
        { "speaker": "B", "ar": "نَحْنُ فِي الْمَدْرَسَةِ الْمُتَوَسِّطَةِ.", "fr": "Nous sommes au collège." },
        { "speaker": "A", "ar": "مَتَى اخْتِبَارُكُنَّ؟", "fr": "Quand est votre examen ?" },
        { "speaker": "B", "ar": "اِخْتِبَارُنَا بَعْدَ شَهْرٍ.", "fr": "Notre examen est dans un mois." },
        {
          "speaker": "A",
          "ar": "أَذَهَبْتُنَّ إِلَى الْمَدْرَسَةِ الْيَوْمَ؟",
          "fr": "Êtes-vous allées à l'école aujourd'hui ?"
        },
        {
          "speaker": "B",
          "ar": "نَعَمْ. ذَهَبْنَا وَرَجَعْنَا.",
          "fr": "Oui. Nous y sommes allées et nous sommes revenues."
        }
      ]
    },

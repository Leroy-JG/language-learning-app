[
  {
    "id": "w:makan",
    "kind": "word",
    "ar": "مَكَانٌ",
    "fr": "un lieu, un endroit",
    "translit": "makānun",
    "plural": "أَمَاكِنُ",
    "gender": "m",
    "note": "{ar|هُنَا} et {ar|هُنَاكَ} désignent un {ar|مَكَانٌ} (un lieu).",
    "example": { "ar": "أَيْنَ هٰذَا الْمَكَانُ؟", "fr": "Où est cet endroit ?" }
  },
  {
    "id": "w:madha",
    "kind": "word",
    "ar": "مَاذَا",
    "fr": "qu'y a-t-il… ? (qu'est-ce que… ?)",
    "translit": "mādhā",
    "note": "Formé de {ar|مَا} et de {ar|ذَا} (forme courte de {ar|هٰذَا}). Comme {ar|مَا}, il demande en principe une chose, pas une personne. Sa terminaison ne change jamais.",
    "example": { "ar": "مَاذَا عَلَى الْمَكْتَبِ؟", "fr": "Qu'y a-t-il sur le bureau ?" }
  },
  {
    "id": "w:limadha",
    "kind": "word",
    "ar": "لِمَاذَا",
    "fr": "pourquoi ?",
    "translit": "limādhā",
    "note": "Formé de {ar|لِ} (« pour »), de {ar|مَا} (« quoi ») et de {ar|ذَا} : « pour quoi ? ». Sa terminaison ne change jamais.",
    "example": { "ar": "لِمَاذَا خَرَجَ زَيْدٌ؟", "fr": "Pourquoi Zayd est-il sorti ?" }
  },
  {
    "id": "w:li-annahu",
    "kind": "word",
    "ar": "لِأَنَّهُ",
    "fr": "parce que",
    "translit": "li-annahu",
    "note": "Il répond à {ar|لِمَاذَا؟}. Il est formé de {ar|لِ} (« pour »), de {ar|أَنَّ} (« que ») et de {ar|هُ} (« il ») : mot à mot « parce que lui… ». Pour une femme : {ar|لِأَنَّهَا} (« parce qu'elle »).",
    "example": { "ar": "لِأَنَّهُ مَرِيضٌ.", "fr": "Parce qu'il est malade." }
  },
  {

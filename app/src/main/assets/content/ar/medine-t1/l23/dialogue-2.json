      "type": "dialogue",
      "title": "Où sont-ils allés ?",
      "intro": "Suite du texte du livre : le professeur demande si le livre est à Muḥammad, puis où sont ʿAlī, Yaʿqūb et Isḥāq.",
      "speakers": {
        "T": { "name": "Le professeur", "voice": "m1" },
        "M": { "name": "Muḥammad", "voice": "m2" },
        "H": { "name": "Ḥāmid", "voice": "m2" }
      },
      "lines": [
        { "speaker": "T", "ar": "أَهٰذَا كِتَابُكَ يَا مُحَمَّدُ؟", "fr": "Est-ce ton livre, Muḥammad ?" },
        { "speaker": "M", "ar": "لَا. هٰذَا كِتَابُ حَمْزَةَ.", "fr": "Non. C'est le livre de Ḥamza." },
        { "speaker": "T", "ar": "أَيْنَ عَلِيٌّ يَا إِخْوَانُ؟", "fr": "Où est ʿAlī, mes frères ?" },
        { "speaker": "H", "ar": "ذَهَبَ إِلَى الرِّيَاضِ.", "fr": "Il est allé à Riyad." },
        { "speaker": "T", "ar": "وَأَيْنَ يَعْقُوبُ؟", "fr": "Et où est Yaʿqūb ?" },
        { "speaker": "H", "ar": "ذَهَبَ إِلَى مَكَّةَ.", "fr": "Il est allé à La Mecque." },
        { "speaker": "T", "ar": "أَيْنَ إِسْحَاقُ؟", "fr": "Où est Isḥāq ?" },
        { "speaker": "M", "ar": "خَرَجَ إِلَى الْمُدِيرِ.", "fr": "Il est sorti voir le directeur." },
        { "speaker": "T", "ar": "مَتَى خَرَجَ؟", "fr": "Quand est-il sorti ?" },
        { "speaker": "M", "ar": "خَرَجَ قَبْلَ خَمْسِ دَقَائِقَ.", "fr": "Il est sorti il y a cinq minutes." }
      ]
    },
